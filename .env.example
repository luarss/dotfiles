# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
#
# Tokens mirror the `token` fields in providers.json — one line per provider.

# --- Claude Profile Tokens ---
ANTHROPIC_AUTH_TOKEN=
DEEPSEEK_AUTH_TOKEN=
XIAOMI_AUTH_TOKEN=

# --- Gemini API (daily-session-log.sh summarizer) ---
GEMINI_API_KEY=
