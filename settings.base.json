{
  "outputStyle": "Concise",
  "promptSuggestionEnabled": false,
  "cleanupPeriodDays": 365,
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "DISABLE_INSTALL_GITHUB_APP_COMMAND": "1",
    "DO_NOT_TRACK": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "npm_config_force": "true"
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rtk *.env)",
      "Bash(rtk *.pem*)",
      "Bash(rtk *.key*)",
      "Bash(rtk *.cnf*)",
      "Bash(rtk *.ssh/*)",
      "Bash(rtk *.aws/*)",
      "Bash(rtk *.config/gcloud/*)",
      "Bash(rtk *.zsh_history*)",
      "Bash(rtk *.bash_history*)",
      "Bash(rtk *.sh_history*)",
      "Bash(rtk *.zhistory*)",
      "Bash(rtk *.history*)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.local)",
      "Read(**/.env.local)",
      "Read(.env.production)",
      "Read(**/.env.production)",
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/*_rsa)",
      "Read(~/.ssh/*_dsa)",
      "Read(~/.ssh/*_ecdsa)",
      "Read(~/.ssh/*_ed25519)",
      "Read(~/.ssh/*key*)",
      "Read(~/.ssh/config)",
      "Read(~/.ssh/config.d/**)",
      "Read(~/.ssh/authorized_keys*)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.hermes/config.yaml)",
      "Read(~/.hermes/auth.json)",
      "Read(~/.hermes/mcp-tokens/**)",
      "Read(~/.hermes/*_token.json)",
      "Read(~/.hermes/channel_directory.json)",
      "Read(~/.hermes/gateway_state.json)",
      "Read(**/*.secret)",
      "Read(**/*_secret.*)",
      "Read(**/*-secret.*)",
      "Read(**/secrets.json)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.yml)",
      "Read(**/*key.pem)",
      "Read(**/*-key.pem)",
      "Read(**/*_key.pem)",
      "Read(**/privkey*.pem)",
      "Read(**/*private*.pem)",
      "Read(**/id_*.pem)",
      "Read(**/*.key)",
      "Read(~/.my.cnf)",
      "Read(**/.my.cnf)",
      "Read(**/my.cnf)",
      "Read(~/.zsh_history)",
      "Read(**/.zsh_history)",
      "Read(~/.bash_history)",
      "Read(**/.bash_history)",
      "Read(~/.sh_history)",
      "Read(**/.sh_history)",
      "Read(~/.zhistory)",
      "Read(**/.zhistory)",
      "Read(~/.history)",
      "Read(**/.history)",
      "Read(~/.python_history)",
      "Read(**/.python_history)",
      "Read(~/.node_repl_history)",
      "Read(**/.node_repl_history)",
      "Read(~/.mysql_history)",
      "Read(**/.mysql_history)",
      "Read(~/.psql_history)",
      "Read(**/.psql_history)",
      "Read(~/.local/share/fish/fish_history)",
      "Read(**/fish_history)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/remote-command-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/db-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/db-rate-limit.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*mysql.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/db-rate-limit.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/archive-session.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/status-line.sh",
    "refreshInterval": 2
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true
  },
  "ignorePatterns": ["bazel-*"],
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
