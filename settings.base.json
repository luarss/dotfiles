{
  "outputStyle": "Concise",
  "promptSuggestionEnabled": false,
  "cleanupPeriodDays": 365,
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "DISABLE_INSTALL_GITHUB_APP_COMMAND": "1",
    "DO_NOT_TRACK": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_AUTOUPDATER": "1",
    "npm_config_force": "true",
    "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
  },
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/db-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/db-rate-limit.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/no-claude-trailer.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*mysql.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/db-rate-limit.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/archive-session.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/status-line.sh",
    "refreshInterval": 2
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-or-agents-md"
      }
    }
  }
}
