{
  "outputStyle": "Concise",
  "promptSuggestionEnabled": false,
  "cleanupPeriodDays": 365,
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "DISABLE_INSTALL_GITHUB_APP_COMMAND": "1",
    "DO_NOT_TRACK": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "npm_config_force": "true"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/remote-command-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/db-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/db-rate-limit.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*mysql.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/db-rate-limit.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/archive-session.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/status-line.sh",
    "refreshInterval": 2
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
