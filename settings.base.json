{
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(gcloud auth print-access-token:*)",
      "Bash(gcloud auth print-identity-token:*)",
      "Bash(gcloud auth application-default print-access-token:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/*_rsa)",
      "Read(~/.ssh/*_dsa)",
      "Read(~/.ssh/*_ecdsa)",
      "Read(~/.ssh/*_ed25519)",
      "Read(~/.ssh/*.pub)",
      "Read(~/.ssh/*key*)",
      "Read(~/.ssh/config)",
      "Read(~/.ssh/config.d/**)",
      "Read(~/.ssh/authorized_keys*)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.hermes/config.yaml)",
      "Read(~/.hermes/auth.json)",
      "Read(~/.hermes/mcp-tokens/**)",
      "Read(~/.hermes/*_token.json)",
      "Read(~/.hermes/channel_directory.json)",
      "Read(~/.hermes/gateway_state.json)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.my.cnf)",
      "Read(**/.my.cnf)",
      "Read(**/my.cnf)",
      "Read(**/*.cnf)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/db-guard.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code needs your attention\" with title \"Claude Code\" subtitle \"Action required\"' && afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/status-line.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
