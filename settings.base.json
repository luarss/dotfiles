{
  "outputStyle": "Concise",
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "DISABLE_INSTALL_GITHUB_APP_COMMAND": "1",
    "DO_NOT_TRACK": "1"
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rtk *.env)",
      "Bash(rtk *.pem*)",
      "Bash(rtk *.key*)",
      "Bash(rtk *.cnf*)",
      "Bash(rtk *.ssh/*)",
      "Bash(rtk *.aws/*)",
      "Bash(rtk *.config/gcloud/*)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.local)",
      "Read(**/.env.local)",
      "Read(.env.production)",
      "Read(**/.env.production)",
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/*_rsa)",
      "Read(~/.ssh/*_dsa)",
      "Read(~/.ssh/*_ecdsa)",
      "Read(~/.ssh/*_ed25519)",
      "Read(~/.ssh/*key*)",
      "Read(~/.ssh/config)",
      "Read(~/.ssh/config.d/**)",
      "Read(~/.ssh/authorized_keys*)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.hermes/config.yaml)",
      "Read(~/.hermes/auth.json)",
      "Read(~/.hermes/mcp-tokens/**)",
      "Read(~/.hermes/*_token.json)",
      "Read(~/.hermes/channel_directory.json)",
      "Read(~/.hermes/gateway_state.json)",
      "Read(**/*.secret)",
      "Read(**/*_secret.*)",
      "Read(**/*-secret.*)",
      "Read(**/secrets.json)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.yml)",
      "Read(**/*key.pem)",
      "Read(**/*-key.pem)",
      "Read(**/*_key.pem)",
      "Read(**/privkey*.pem)",
      "Read(**/*private*.pem)",
      "Read(**/id_*.pem)",
      "Read(**/*.key)",
      "Read(~/.my.cnf)",
      "Read(**/.my.cnf)",
      "Read(**/my.cnf)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/remote-command-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/db-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/db-rate-limit.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*mysql.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/db-rate-limit.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/status-line.sh",
    "refreshInterval": 2
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true
  },
  "ignorePatterns": ["bazel-*"],
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
