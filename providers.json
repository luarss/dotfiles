{
  "default": {
    "dir": ".claude",
    "aliases": ["claude"],
    "token": "ANTHROPIC_AUTH_TOKEN",
    "thirdParty": false,
    "overrides": {
      "model": "opus[1m]",
      "effortLevel": "high",
      "env": { "RTK_TELEMETRY_DISABLED": "1" },
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "Bash",
            "hooks": [
              { "type": "command", "command": "bash ~/.claude/hooks/remote-command-guard.sh" },
              { "type": "command", "command": "bash ~/.claude/hooks/db-guard.sh" },
              { "type": "command", "command": "bash ~/.claude/hooks/db-rate-limit.sh" },
              { "type": "command", "command": "bash ~/.claude/hooks/skill-scan-guard.sh" },
              { "type": "command", "command": "rtk hook claude" }
            ]
          },
          {
            "matcher": "mcp__.*mysql.*",
            "hooks": [
              { "type": "command", "command": "bash ~/.claude/hooks/db-rate-limit.sh" }
            ]
          }
        ],
        "PostToolUse": [
          {
            "matcher": "Write|Edit",
            "hooks": [
              { "type": "command", "command": "bash ~/.claude/hooks/symlink-memory.sh" }
            ]
          }
        ]
      }
    }
  },
  "deepseek": {
    "dir": ".claude-second-profile",
    "aliases": ["s-claude"],
    "token": "DEEPSEEK_AUTH_TOKEN",
    "thirdParty": true,
    "baseUrl": "https://api.deepseek.com/anthropic",
    "models": {
      "haiku": "deepseek-v4-flash",
      "sonnet": "deepseek-v4-pro[1m]",
      "opus": "deepseek-v4-pro[1m]"
    },
    "overrides": {
      "model": "opus",
      "alwaysThinkingEnabled": true,
      "promptSuggestionEnabled": false
    }
  },
  "mimo": {
    "dir": ".claude-third-profile",
    "aliases": ["d-claude"],
    "token": "XIAOMI_AUTH_TOKEN",
    "thirdParty": true,
    "baseUrl": "https://api.xiaomimimo.com/anthropic",
    "models": "mimo-v2.5",
    "overrides": {
      "model": "opus",
      "alwaysThinkingEnabled": true,
      "promptSuggestionEnabled": false
    }
  }
}
